# ===== 内网自建 LLM(OpenAI 兼容接口)=====
# 内网 LLM 服务的 API base 地址,例如 http://10.x.x.x:8000/v1
LLM_API_BASE=http://your-intranet-llm-host:8000/v1
# 内网 LLM 的模型名,例如 qwen2.5-72b、deepseek-chat 等
LLM_MODEL_NAME=your-llm-model-name
# 内网 LLM 的 API key(若无需鉴权可留 dbgpt)
LLM_API_KEY=dbgpt

# ===== traffic_guard 开关 =====
# false(默认):全放行,内网无感
# true:启用拦截(GET 放行 + 内部地址/白名单域名的 POST 放行,其余 POST 拦截)
TRAFFIC_GUARD_ENABLED=false
# (可选)额外放行 POST 的域名,逗号分隔,例如 llm.internal.com,vllm.internal.com
# TRAFFIC_GUARD_ALLOW_DOMAINS=

# ===== 本地多模态两阶段(MiniCPM-V 识图 → 内网 LLM 答题)=====
# 默认关。开了之后:用户在聊天里上传图片 → 本地 minicpm-v(CPU,ollama)把图 OCR 成文字 → 文字喂给内网 LLM 答题。
# 需要 ollama 镜像里烤了 minicpm-v 模型(见 README 多模态章节)。
VISION_OCR_ENABLED=false
# ollama 视觉模型名(ollama 镜像里烤的)
VISION_OCR_MODEL=minicpm-v
# ollama 服务地址(容器内网络)
VISION_OCR_API_URL=http://ollama:11434

